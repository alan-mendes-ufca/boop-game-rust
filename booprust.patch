+// ---------------------------------------------------------------------
+// 3. Regra de forca entre gatinho e gatao
+// ---------------------------------------------------------------------
+
+mod boop_forca_das_pecas {
+    use super::*;
+
+    #[test]
+    fn gatinho_nao_empurra_gatao() {
+        let mut tabuleiro = Tabuleiro::novo();
+        let mut maos = Maos::novas();
